      </Annotations>
      <Annotations Target="microsoft.graph.macOSDeviceFeaturesConfiguration/contentCachingEnabled">
        <Annotation Term="Org.OData.Core.V1.Description" String="Enables content caching and prevents it from being disabled by the user." />
