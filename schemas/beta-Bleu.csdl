      </Annotations>
      <Annotations Target="microsoft.graph.macOSDeviceFeaturesConfiguration/contentCachingPeerListenRanges">
        <Annotation Term="Org.OData.Core.V1.Description" String="A list of custom IP ranges content caches will use to listen for peer caches. This collection can contain a maximum of 500 elements." />
