      </Annotations>
      <Annotations Target="microsoft.graph.cloudCertificationAuthority/validityPeriodInYears">
        <Annotation Term="Org.OData.Core.V1.Description" String="The certification authority validity period in years configured by admins." />
      </Annotations>
      <Annotations Target="microsoft.graph.cloudCertificationAuthority/validityStartDateTime">
