      </Annotations>
      <Annotations Target="microsoft.graph.fotaRegistrationState/inProgress">
        <Annotation Term="Org.OData.Core.V1.Description" String="Registration is in progress by the OEM." />
      </Annotations>
      <Annotations Target="microsoft.graph.fotaRegistrationState/pending">
