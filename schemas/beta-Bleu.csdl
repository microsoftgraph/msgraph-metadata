      <Annotations Target="microsoft.graph.ddmAppAllowDownloadsOverCellular">
        <Annotation Term="Org.OData.Core.V1.Description" String="Describes how and when to install an app, specifically whether the app may be downloaded over cellular connections. Maps to Apple's AppManagedInstallBehaviorObject declaration." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAllowDownloadsOverCellular/alwaysOff">
        <Annotation Term="Org.OData.Core.V1.Description" String="The device doesn't download apps using a cellular network. The device pauses the automatic install or update operation until a different network is active." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAllowDownloadsOverCellular/alwaysOn">
        <Annotation Term="Org.OData.Core.V1.Description" String="The device downloads apps of any size using a cellular network." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAllowDownloadsOverCellular/storeSettings">
        <Annotation Term="Org.OData.Core.V1.Description" String="The device uses the settings for the corresponding store when downloading apps." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAllowDownloadsOverCellular/unknownFutureValue">
        <Annotation Term="Org.OData.Core.V1.Description" String="Evolvable enumeration sentinel value. Do not use." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAutomaticAppUpdates">
        <Annotation Term="Org.OData.Core.V1.Description" String="Specifies the update behavior of the apps installed via VPP. Apps in packages are not automatically updated. Maps to Apple's AppManagedUpdateBehaviorObject declaration." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAutomaticAppUpdates/alwaysOff">
        <Annotation Term="Org.OData.Core.V1.Description" String="The device never automatically updates the app." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAutomaticAppUpdates/alwaysOn">
        <Annotation Term="Org.OData.Core.V1.Description" String="The device automatically updates the app to the latest version." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAutomaticAppUpdates/storeSettings">
        <Annotation Term="Org.OData.Core.V1.Description" String="The device uses the settings for the corresponding store to determine when to automatically update the app." />
      </Annotations>
      <Annotations Target="microsoft.graph.ddmAppAutomaticAppUpdates/unknownFutureValue">
