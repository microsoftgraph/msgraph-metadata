      <Annotations Target="microsoft.graph.onboardingStatus/unknownFutureValue">
        <Annotation Term="Org.OData.Core.V1.Description" String="UnknownFutureValue" />
      </Annotations>
      <Annotations Target="microsoft.graph.onPremisesApplicationSegment">
        <Annotation Term="Org.OData.Core.V1.Revisions">
          <Collection>
            <Record>
              <PropertyValue Property="Date" Date="2023-06-01" />
              <PropertyValue Property="Description" String="The onPremisesApplicationSegment type is deprecated and will being used on June 01, 2023. Please use the new applicationSegment type." />
              <PropertyValue Property="Kind">
                <EnumMember>Org.OData.Core.V1.RevisionKind/Deprecated</EnumMember>
              </PropertyValue>
              <PropertyValue Property="RemovalDate" Date="2023-06-01" />
