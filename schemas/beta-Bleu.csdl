        <Annotation Term="Org.OData.Core.V1.Description" String="Versions bigger than the specified version will block the managed app from accessing company data. For example: '8.1.0' or '13.1.1'." />
      </Annotations>
      <Annotations Target="microsoft.graph.windowsManagedAppProtection/maximumWarningOsVersion">
        <Annotation Term="Org.OData.Core.V1.Description" String="Versions bigger than the specified version will result in warning message on the managed app from accessing company data. For example: '8.1.0' or '13.1.1'." />
      </Annotations>
      <Annotations Target="microsoft.graph.windowsManagedAppProtection/maximumWipeOsVersion">
        <Annotation Term="Org.OData.Core.V1.Description" String="Versions bigger than the specified version will wipe the managed app and the associated company data. For example: '8.1.0' or '13.1.1'." />
      </Annotations>
      <Annotations Target="microsoft.graph.windowsManagedAppProtection/minimumRequiredAppVersion">
        <Annotation Term="Org.OData.Core.V1.Description" String="Versions less than the specified version will block the managed app from accessing company data. For example: '8.1.0' or '13.1.1'." />
      </Annotations>
