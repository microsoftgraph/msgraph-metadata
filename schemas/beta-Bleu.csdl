      <Annotations Target="microsoft.graph.androidWorkProfileWiFiConfiguration/connectAutomatically">
        <Annotation Term="Org.OData.Core.V1.Description" String="When set to true, device will connect automatically to the Wi-Fi network when in range, skipping the user prompt. When false, user will need to connect manually through Settings on the Android device. Default value is false." />
