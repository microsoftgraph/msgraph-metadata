        <Annotation Term="Org.OData.Core.V1.LongDescription" String="The input must match the following regular expression: '^[0-9]{19}[0-9]?$'." />
      </Annotations>
      <Annotations Target="microsoft.graph.embeddedSIMActivationCode/matchingIdentifier">
        <Annotation Term="Org.OData.Core.V1.Description" String="The MatchingIdentifier (MatchingID) as specified in the GSMA Association SGP.22 RSP Technical Specification section 4.1." />
        <Annotation Term="Org.OData.Core.V1.LongDescription" String="The input must match the following regular expression: '^[a-zA-Z0-9\-]*$'." />
      </Annotations>
      <Annotations Target="microsoft.graph.embeddedSIMActivationCode/smdpPlusServerAddress">
