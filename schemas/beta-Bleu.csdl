      </Annotations>
      <Annotations Target="microsoft.graph.androidWiFiSecurityType/wpa2Enterprise">
        <Annotation Term="Org.OData.Core.V1.Description" String="Indicates Android Wifi Security Type is set to WPA2 encryption. Must use AndroidWorkProfileEnterpriseWifiConfiguration type to configure enterprise options." />
      </Annotations>
