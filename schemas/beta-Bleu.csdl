      </Annotations>
      <Annotations Target="microsoft.graph.deviceAndAppManagementAssignmentFilter/assignmentFilterManagementType">
        <Annotation Term="Org.OData.Core.V1.Description" String="Indicates filter is applied to either 'devices' or 'apps' management type. Possible values are devices, apps. Default filter will be applied to 'devices'" />
