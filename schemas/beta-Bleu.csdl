      </Annotations>
      <Annotations Target="microsoft.graph.deviceCleanupRulePlatformType/visionOS">
        <Annotation Term="Org.OData.Core.V1.Description" String="Indicates that clean up rule is associated with visionOS managed device platform." />
      </Annotations>
      <Annotations Target="microsoft.graph.deviceCleanupRulePlatformType/windows">
        <Annotation Term="Org.OData.Core.V1.Description" String="Indicates that clean up rule is associated with Windows managed device platform." />
