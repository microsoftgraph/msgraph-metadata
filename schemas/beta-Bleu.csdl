      <Annotations Target="microsoft.graph.windowsManagedAppProtection/allowedInboundDataTransferSourceApps">
        <Annotation Term="Org.OData.Core.V1.Description" String="When allowedInboundDataTransferSources is set to selectedApps, this property indicates the location from which data is allowed to be received into the org context. Data from the selected source will be treated as org data and subject to Intune app protection policy." />
      </Annotations>
      <Annotations Target="microsoft.graph.windowsManagedAppProtection/allowedInboundDataTransferSources">
        <Annotation Term="Org.OData.Core.V1.Description" String="Indicates the sources from which data is allowed to be transferred. Some possible values are allApps, none, or selectedApps." />
      </Annotations>
