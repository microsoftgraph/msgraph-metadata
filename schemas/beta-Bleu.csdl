      <Annotations Target="microsoft.graph.androidWorkProfileWiFiConfiguration/connectWhenNetworkNameIsHidden">
        <Annotation Term="Org.OData.Core.V1.Description" String="When set to true, this profile forces the device to connect to a network that doesn't broadcast its SSID to all devices. When false, device will not automatically connect to hidden networks. Default value is false." />
